{
  "opencollection": "1.0.0",
  "info": {
    "name": "Public Account Table options API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Table options",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List field options",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/tables/:name/fields/:fieldId/tags",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "fieldId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the options (tags) defined on a select/tags field."
        },
        {
          "info": {
            "name": "Create field option",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://prod-api.getfrontline.ai/public/v1/tables/:name/fields/:fieldId/tags",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "fieldId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds an option (tag) to a select/tags field. Requires a USER API key."
        },
        {
          "info": {
            "name": "Update field option",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://prod-api.getfrontline.ai/public/v1/tables/:name/tags/:tagId",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "tagId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an option's name, color, or order. Requires a USER API key."
        },
        {
          "info": {
            "name": "Delete field option",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://prod-api.getfrontline.ai/public/v1/tables/:name/tags/:tagId",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "tagId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes an option from a select/tags field. Requires a USER API key."
        }
      ]
    }
  ],
  "bundled": true
}