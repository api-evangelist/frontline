{
  "opencollection": "1.0.0",
  "info": {
    "name": "Public Account Workflows API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Workflows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all workflows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows",
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of workflows associated with the account. Nodes and logic are excluded."
        },
        {
          "info": {
            "name": "Create a workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates an automation workflow and an empty graph snapshot."
        },
        {
          "info": {
            "name": "Get workflow details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              },
              {
                "name": "includeNodes",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a workflow automation. Pass includeNodes=true to include graph nodes."
        },
        {
          "info": {
            "name": "Update workflow",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates workflow metadata or status."
        },
        {
          "info": {
            "name": "Delete workflow",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Soft deletes a workflow automation and cleans up trigger side effects."
        },
        {
          "info": {
            "name": "Get workflow graph",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId/graph",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the workflow snapshot with nodes and edges."
        },
        {
          "info": {
            "name": "Create workflow node",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId/nodes",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a node in an automation workflow graph."
        },
        {
          "info": {
            "name": "Update workflow node",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId/nodes/:nodeId",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              },
              {
                "name": "nodeId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates a node and returns the updated workflow graph."
        },
        {
          "info": {
            "name": "Delete workflow node",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId/nodes/:nodeId",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              },
              {
                "name": "nodeId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes a node and removes all incoming and outgoing edges."
        },
        {
          "info": {
            "name": "Create workflow edge",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId/edges",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Adds or replaces the outgoing edge for a node."
        },
        {
          "info": {
            "name": "Delete workflow edge",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId/edges",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Removes an edge from the workflow graph."
        },
        {
          "info": {
            "name": "Get workflow analytics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId/analytics",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns analytics for a specific workflow, including runs by date and summary."
        },
        {
          "info": {
            "name": "List workflow run logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId/logs",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "start_date",
                "value": "",
                "type": "query"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists the run history (executions) of a workflow. Requires a USER API key."
        },
        {
          "info": {
            "name": "Get a workflow run log",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId/logs/:logId",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              },
              {
                "name": "logId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns one run with its per-node results. Requires a USER API key."
        }
      ]
    }
  ],
  "bundled": true
}