{
  "opencollection": "1.0.0",
  "info": {
    "name": "Public Account Table fields API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Table fields",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List table fields",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/tables/:name/fields",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the columns defined on a table."
        },
        {
          "info": {
            "name": "Create table field",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://prod-api.getfrontline.ai/public/v1/tables/:name/fields",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a column on a table. Requires a USER API key."
        },
        {
          "info": {
            "name": "Update table field",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://prod-api.getfrontline.ai/public/v1/tables/:name/fields/:fieldId",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "fieldId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a field's metadata, defaults, or ordering. Requires a USER API key."
        },
        {
          "info": {
            "name": "Delete table field",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://prod-api.getfrontline.ai/public/v1/tables/:name/fields/:fieldId",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "fieldId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes a column from a table. Requires a USER API key."
        },
        {
          "info": {
            "name": "Get table field formula dependencies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/tables/:name/fields/:fieldId/formula-dependencies",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "fieldId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the formula dependencies for a specific field."
        },
        {
          "info": {
            "name": "Preview formula evaluation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://prod-api.getfrontline.ai/public/v1/tables/:name/fields/preview-formula",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Previews formula evaluation on existing data. Requires a USER API key."
        }
      ]
    }
  ],
  "bundled": true
}