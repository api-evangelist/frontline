{
  "opencollection": "1.0.0",
  "info": {
    "name": "Public Account AI Models API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "AI Models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List AI models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/ai-models",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns available AI models. Use these IDs when configuring an agent setting."
        },
        {
          "info": {
            "name": "Get default AI model",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/ai-models/default",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the default AI model for the requested model type."
        },
        {
          "info": {
            "name": "Get AI model",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/ai-models/:aiModelId",
            "params": [
              {
                "name": "aiModelId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns one AI model by ID."
        }
      ]
    }
  ],
  "bundled": true
}