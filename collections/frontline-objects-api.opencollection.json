{
  "opencollection": "1.0.0",
  "info": {
    "name": "Public Account Objects API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Objects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List objects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/objects"
          },
          "docs": "Returns every object (standard + custom) for the authenticated account."
        },
        {
          "info": {
            "name": "Create object",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://prod-api.getfrontline.ai/public/v1/objects",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a custom object. At least one column is required. Requires a USER API key."
        },
        {
          "info": {
            "name": "Get object",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/objects/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns one object including fields, views, and record types."
        },
        {
          "info": {
            "name": "Update object",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://prod-api.getfrontline.ai/public/v1/objects/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an object's display name, emoji, color, or description. Requires a USER API key."
        },
        {
          "info": {
            "name": "Delete object",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://prod-api.getfrontline.ai/public/v1/objects/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes a custom object. System objects cannot be deleted. Requires a USER API key."
        },
        {
          "info": {
            "name": "Get object schema",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/objects/:name/schema",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns only the schema (fields, types, formats) for an object."
        }
      ]
    }
  ],
  "bundled": true
}