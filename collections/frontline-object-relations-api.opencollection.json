{
  "opencollection": "1.0.0",
  "info": {
    "name": "Public Account Object relations API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Object relations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List related rows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/objects/:name/rows/:id/relations/:relation",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "relation",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns rows linked to this row via the given relation field."
        },
        {
          "info": {
            "name": "Find rows by relation target",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/objects/:name/relations/:relation/target/:targetId",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "relation",
                "value": "",
                "type": "path"
              },
              {
                "name": "targetId",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              },
              {
                "name": "search",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns rows on the source object linked to the target id via the relation."
        },
        {
          "info": {
            "name": "Link relation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://prod-api.getfrontline.ai/public/v1/objects/:name/rows/:id/relations/:relation/link",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "relation",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Links the target row to this row via the relation. Requires a USER API key."
        },
        {
          "info": {
            "name": "Unlink relation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://prod-api.getfrontline.ai/public/v1/objects/:name/rows/:id/relations/:relation/unlink",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "relation",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Unlinks the target row from this row's relation. Requires a USER API key."
        }
      ]
    }
  ],
  "bundled": true
}