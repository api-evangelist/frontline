{
  "opencollection": "1.0.0",
  "info": {
    "name": "Public Account Workflow Variables API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Workflow Variables",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List workflow variables",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId/variables",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              },
              {
                "name": "filterText",
                "value": "",
                "type": "query"
              },
              {
                "name": "isDefault",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists variables for an automation workflow. Requires a USER API key."
        },
        {
          "info": {
            "name": "Create workflow variable",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId/variables",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a variable for an automation workflow. Requires a USER API key."
        },
        {
          "info": {
            "name": "List all workflow variables",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId/variables/all",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists all workflow variables including defaults. Requires a USER API key."
        },
        {
          "info": {
            "name": "Check workflow variable name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId/variables/check-name",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              },
              {
                "name": "name",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Checks whether a variable name exists for a workflow. Requires a USER API key."
        },
        {
          "info": {
            "name": "Get workflow variable",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId/variables/:variableId",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              },
              {
                "name": "variableId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Manages a single workflow variable. Requires a USER API key."
        },
        {
          "info": {
            "name": "Update workflow variable",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId/variables/:variableId",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              },
              {
                "name": "variableId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Manages a single workflow variable. Requires a USER API key."
        },
        {
          "info": {
            "name": "Delete workflow variable",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://prod-api.getfrontline.ai/public/v1/workflows/:workflowId/variables/:variableId",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              },
              {
                "name": "variableId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Manages a single workflow variable. Requires a USER API key."
        }
      ]
    }
  ],
  "bundled": true
}