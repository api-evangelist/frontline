{
  "opencollection": "1.0.0",
  "info": {
    "name": "Public Account Flow Variables API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Flow Variables",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List agent variables",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/agents/:agentId/variables",
            "params": [
              {
                "name": "agentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "filterText",
                "value": "",
                "type": "query"
              },
              {
                "name": "isDefault",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists variables for an agent. Requires a USER API key."
        },
        {
          "info": {
            "name": "Create agent variable",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://prod-api.getfrontline.ai/public/v1/agents/:agentId/variables",
            "params": [
              {
                "name": "agentId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a variable for an agent. Requires a USER API key."
        },
        {
          "info": {
            "name": "List all agent variables",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/agents/:agentId/variables/all",
            "params": [
              {
                "name": "agentId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists all agent variables including defaults. Requires a USER API key."
        },
        {
          "info": {
            "name": "Check agent variable name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/agents/:agentId/variables/check-name",
            "params": [
              {
                "name": "agentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "name",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Checks whether a variable name exists for an agent. Requires a USER API key."
        },
        {
          "info": {
            "name": "Get agent variable",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/agents/:agentId/variables/:variableId",
            "params": [
              {
                "name": "agentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "variableId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Manages a single agent variable. Requires a USER API key."
        },
        {
          "info": {
            "name": "Update agent variable",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://prod-api.getfrontline.ai/public/v1/agents/:agentId/variables/:variableId",
            "params": [
              {
                "name": "agentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "variableId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Manages a single agent variable. Requires a USER API key."
        },
        {
          "info": {
            "name": "Delete agent variable",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://prod-api.getfrontline.ai/public/v1/agents/:agentId/variables/:variableId",
            "params": [
              {
                "name": "agentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "variableId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Manages a single agent variable. Requires a USER API key."
        }
      ]
    }
  ],
  "bundled": true
}