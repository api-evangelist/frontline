{
  "opencollection": "1.0.0",
  "info": {
    "name": "Public Account Table activities API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Table activities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List activities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/tables/:name/rows/:rowId/activities",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "rowId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns manually-created activities attached to a row. Activities log interactions like notes, calls, meetings, and emails."
        },
        {
          "info": {
            "name": "Create activity",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://prod-api.getfrontline.ai/public/v1/tables/:name/rows/:rowId/activities",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "rowId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Attaches a manual activity to a row. Use `type` to categorize it (NOTE, PHONE_CALL, MEETING, EMAIL, WHATSAPP). Requires a USER API key."
        },
        {
          "info": {
            "name": "Get activity",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/tables/:name/activities/:id",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns an activity by id."
        },
        {
          "info": {
            "name": "Update activity",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://prod-api.getfrontline.ai/public/v1/tables/:name/activities/:id",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an activity. Requires a USER API key."
        },
        {
          "info": {
            "name": "Delete activity",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://prod-api.getfrontline.ai/public/v1/tables/:name/activities/:id",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes a manually-created activity. Only the owner or an account admin can delete. Auto-generated activities cannot be deleted. Requires a USER API key."
        }
      ]
    }
  ],
  "bundled": true
}