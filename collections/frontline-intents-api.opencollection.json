          "info": {
            "name": "List intents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod-api.getfrontline.ai/public/v1/agents/:agentId/intents",
            "params": [
              {
                "name": "agentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "filterText",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeUsedStatus",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists agent intents. Requires a USER API key."
        },
        {
          "info": {
            "name": "Create intent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://prod-api.getfrontline.ai/public/v1/agents/:agentId/intents",
